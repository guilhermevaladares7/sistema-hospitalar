@startuml diagrama-classes
title Sistema de Informação Hospitalar — Diagrama de Classes (Modelo de Domínio) — Sprint 2

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 70
skinparam class {
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCE8F3
  BorderColor #3D5A80
  ArrowColor #3D5A80
}
skinparam package {
  BorderColor #3D5A80
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #C9B458
}

package model {

  ' ===================== PESSOAS =====================

  abstract class Pessoa {
    #id : Long
    #nome : String
    #telefone : String
    #email : String
  }

  class Paciente {
    -cpf : String
    -dataNascimento : LocalDate
    -endereco : Endereco
    +getIdade() : int
    +adicionarConsulta(c : Consulta) : void
    +adicionarInternacao(i : Internacao) : void
    +adicionarAtendimentoEmergencia(a : AtendimentoEmergencia) : void
    +adicionarProcedimento(p : ProcedimentoCirurgico) : void
    +possuiInternacaoAtiva() : boolean
    +getHistorico() : HistoricoMedico
  }

  class Endereco <<embeddable>> {
    -logradouro : String
    -numero : String
    -complemento : String
    -bairro : String
    -cidade : String
    -uf : String
    -cep : String
    +getEnderecoCompleto() : String
  }

  abstract class ProfissionalSaude {
    -registroProfissional : String
    +{abstract} getCategoria() : CategoriaProfissional
    +podeEncaminhar() : boolean
    +atuaEm(e : Especialidade) : boolean
    +realizaConsultaDeRotina() : boolean
    +realizaProcedimentoCirurgico() : boolean
    +encaminhar(c : ConsultaRotina, dest : Especialidade, motivo : String, data : LocalDate) : Encaminhamento
    +adicionarDisponibilidade(d : Disponibilidade) : void
    +adicionarConsulta(c : Consulta) : void
    +adicionarProcedimento(p : ProcedimentoCirurgico) : void
    +estaDisponivel(data : LocalDate, horario : LocalTime) : boolean
    +possuiOutraConsultaNoHorario(c : Consulta) : boolean
    +possuiOutroProcedimentoNoHorario(p : ProcedimentoCirurgico) : boolean
  }

  class ClinicoGeral {
    +getCategoria() : CategoriaProfissional
    +podeEncaminhar() : boolean
    +realizaConsultaDeRotina() : boolean
  }

  class Especialista {
    -especialidade : Especialidade
    +getCategoria() : CategoriaProfissional
    +atuaEm(e : Especialidade) : boolean
  }

  class Cirurgiao {
    -areaCirurgica : AreaCirurgica
    +getCategoria() : CategoriaProfissional
    +realizaProcedimentoCirurgico() : boolean
    +adicionarProcedimento(p : ProcedimentoCirurgico) : void
    +getProcedimentosRealizados() : List<ProcedimentoCirurgico>
  }

  class Disponibilidade {
    -id : Long
    -diaSemana : DayOfWeek
    -horaInicio : LocalTime
    -horaFim : LocalTime
    +contem(data : LocalDate, horario : LocalTime) : boolean
  }

  ' ===================== ATENDIMENTOS =====================

  abstract class Atendimento {
    #id : Long
    #observacoes : String
    +registrarObservacao(texto : String) : void
    +{abstract} validarRealizacao() : void
    +{abstract} getDataReferencia() : LocalDate
    +{abstract} getResumo() : String
  }

  abstract class Consulta {
    -data : LocalDate
    -horario : LocalTime
    -motivo : String
    -situacao : SituacaoConsulta
    +{abstract} getModalidade() : ModalidadeConsulta
    #validarHorarioNaAgenda() : void
    +confirmar() : void
    +iniciar() : void
    +concluir(observacoes : String) : void
    +cancelar() : void
    +registrarNaoComparecimento() : void
    +conflitaCom(data : LocalDate, horario : LocalTime) : boolean
  }

  class ConsultaRotina {
    +getModalidade() : ModalidadeConsulta
    +validarRealizacao() : void
  }

  class ConsultaEspecializada {
    -especialidade : Especialidade
    +getModalidade() : ModalidadeConsulta
    +validarRealizacao() : void
  }

  class AtendimentoEmergencia {
    -prioridade : Prioridade
    -situacao : SituacaoEmergencia
    -dataHoraChegada : LocalDateTime
    +{static} ORDEM_DE_ATENDIMENTO : Comparator
    +validarRealizacao() : void
    +iniciar() : void
    +concluir(observacoes : String) : void
    +aguardaAvaliacao() : boolean
  }

  class ProcedimentoCirurgico {
    -descricao : String
    -tipoCirurgia : TipoCirurgia
    -observacoesPreOperatorias : String
    -observacoesPosOperatorias : String
    -dataHoraPrevista : LocalDateTime
    -dataHoraInicio : LocalDateTime
    -dataHoraFim : LocalDateTime
    -situacao : SituacaoProcedimento
    +validarRealizacao() : void
    +iniciar(inicio : LocalDateTime) : void
    +concluir(fim : LocalDateTime, obs : String) : void
    +cancelar() : void
    +foiRealizado() : boolean
    +conflitaCom(dataHora : LocalDateTime) : boolean
  }

  class Internacao {
    -dataEntrada : LocalDate
    -dataPrevistaAlta : LocalDate
    -dataEfetivaAlta : LocalDate
    -comAcompanhante : boolean
    +validarRealizacao() : void
    +estaAtiva() : boolean
    +darAlta(data : LocalDate) : void
    +getDiasCobrados() : long
    +getValorDiaria() : BigDecimal
    +getValorTotal() : BigDecimal
  }

  class Encaminhamento {
    -id : Long
    -especialidadeDestino : Especialidade
    -motivo : String
    -data : LocalDate
  }

  ' ===================== QUARTOS =====================

  abstract class Quarto {
    -id : Long
    -numero : String
    -andar : int
    -valorBaseDiaria : BigDecimal
    -possuiArCondicionado : boolean
    -possuiBanheiroPrivativo : boolean
    -situacao : SituacaoQuarto
    +{abstract} getTipo() : TipoQuarto
    +{abstract} getCapacidadeMaxima() : int
    +{abstract} calcularDiaria(comAcompanhante : boolean) : BigDecimal
    +{abstract} permiteAcompanhante() : boolean
    +validarAcompanhante(comAcompanhante : boolean) : void
    +getOcupacaoAtual() : int
    +temVaga() : boolean
    +ocupar(i : Internacao) : void
    +liberar(i : Internacao) : void
  }

  class Enfermaria {
    -quantidadeLeitos : int
    +getTipo() : TipoQuarto
    +calcularDiaria(comAcompanhante : boolean) : BigDecimal
    +permiteAcompanhante() : boolean
    +getCapacidadeMaxima() : int
    +getPercentualDesconto() : BigDecimal
  }

  class Apartamento {
    -tipoLeito : TipoLeito
    -possuiLeitoAcompanhante : boolean
    +getTipo() : TipoQuarto
    +calcularDiaria(comAcompanhante : boolean) : BigDecimal
    +permiteAcompanhante() : boolean
    +getCapacidadeMaxima() : int
  }

  class Uti {
    -quantidadeLeitos : int
    -possuiIsolamento : boolean
    +getTipo() : TipoQuarto
    +calcularDiaria(comAcompanhante : boolean) : BigDecimal
    +permiteAcompanhante() : boolean
    +getCapacidadeMaxima() : int
  }

  ' ===================== HISTÓRICO =====================

  class HistoricoMedico {
    +getAtendimentos() : List<Atendimento>
    +getConsultasConcluidas() : List<Consulta>
    +getInternacoes() : List<Internacao>
  }

  ' ===================== ENUMS =====================

  enum CategoriaProfissional {
    CLINICO_GERAL
    ESPECIALISTA
    CIRURGIAO
  }

  enum Especialidade {
    CARDIOLOGIA
    PEDIATRIA
    ORTOPEDIA
    NEUROLOGIA
    DERMATOLOGIA
    ENFERMAGEM
  }

  enum AreaCirurgica {
    GERAL
    CARDIOVASCULAR
    ORTOPEDICA
    NEUROLOGICA
    PEDIATRICA
    PLASTICA
  }

  enum ModalidadeConsulta {
    ROTINA
    ESPECIALIZADA
  }

  enum SituacaoConsulta {
    AGENDADA
    CONFIRMADA
    EM_ATENDIMENTO
    CONCLUIDA
    CANCELADA
    NAO_COMPARECEU
    --
    +podeMudarPara(nova) : boolean
    +validarMudancaPara(nova) : void
    +ocupaHorario() : boolean
  }

  enum SituacaoEmergencia {
    AGUARDANDO_AVALIACAO
    EM_ATENDIMENTO
    CONCLUIDO
    --
    +podeMudarPara(nova) : boolean
    +validarMudancaPara(nova) : void
  }

  enum SituacaoProcedimento {
    AGENDADO
    EM_ANDAMENTO
    CONCLUIDO
    CANCELADO
    --
    +podeMudarPara(nova) : boolean
    +validarMudancaPara(nova) : void
    +ocupaHorario() : boolean
  }

  enum Prioridade {
    BAIXA
    MODERADA
    ALTA
    CRITICA
    --
    +ehMaisUrgenteQue(outra) : boolean
  }

  enum TipoQuarto {
    ENFERMARIA
    APARTAMENTO
    UTI
  }

  enum TipoLeito {
    PADRAO
    ELETRICO
  }

  enum TipoCirurgia {
    ELETIVA
    URGENCIA
    EMERGENCIA
  }

  enum SituacaoQuarto {
    DISPONIVEL
    OCUPADO
  }

  ' ===================== HERANÇAS =====================

  Pessoa <|-- Paciente
  Pessoa <|-- ProfissionalSaude
  ProfissionalSaude <|-- ClinicoGeral
  ProfissionalSaude <|-- Especialista
  ProfissionalSaude <|-- Cirurgiao

  Atendimento <|-- Consulta
  Atendimento <|-- Internacao
  Atendimento <|-- AtendimentoEmergencia
  Atendimento <|-- ProcedimentoCirurgico
  Consulta <|-- ConsultaRotina
  Consulta <|-- ConsultaEspecializada

  Quarto <|-- Enfermaria
  Quarto <|-- Apartamento
  Quarto <|-- Uti

  ' ===================== ASSOCIAÇÕES =====================

  Paciente "1" *-- "1" Endereco
  ProfissionalSaude "1" *-- "0..*" Disponibilidade

  Atendimento "0..*" --> "1" Paciente : paciente >
  Atendimento "0..*" --> "1" ProfissionalSaude : profissional >
  Internacao "0..*" --> "1" Quarto : alojado em >
  Cirurgiao "1" -- "0..*" ProcedimentoCirurgico : realiza >

  Encaminhamento "0..*" --> "1" Paciente
  Encaminhamento "0..*" --> "1" ProfissionalSaude : clínico >
  Encaminhamento "0..*" --> "1" ConsultaRotina : origem >

  HistoricoMedico "0..1" --> "1" Paciente : referente a >
  HistoricoMedico ..> Atendimento : <<usa>>

  ' ===================== DEPENDÊNCIAS DE ENUM =====================

  ProfissionalSaude ..> CategoriaProfissional
  Especialista --> Especialidade
  Cirurgiao --> AreaCirurgica
  Consulta --> SituacaoConsulta
  Consulta ..> ModalidadeConsulta
  ConsultaEspecializada --> Especialidade
  AtendimentoEmergencia --> Prioridade
  AtendimentoEmergencia --> SituacaoEmergencia
  ProcedimentoCirurgico --> TipoCirurgia
  ProcedimentoCirurgico --> SituacaoProcedimento
  Encaminhamento --> Especialidade
  Quarto --> SituacaoQuarto
  Quarto ..> TipoQuarto
  Apartamento --> TipoLeito

  note top of Pessoa
    Getters e setters omitidos
    em todas as classes.
  end note

  note top of HistoricoMedico
    Não é persistido: montado sob demanda a
    partir das consultas, internações, emergências
    e procedimentos do paciente.
  end note

  note bottom of Atendimento
    @MappedSuperclass. Cada subclasse implementa
    validarRealizacao() com as regras da sua
    modalidade (Template Method).
  end note
}

@enduml
